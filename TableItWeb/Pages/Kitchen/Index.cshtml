@page "/Kitchen"
@model TableItWeb.Pages.Kitchen.KitchenIndexModel
@{
    ViewData["Title"] = "Kitchen";
    ViewData["FullWidth"] = true;
    ViewData["HideFooter"] = true;
}

@section Styles {
<style>
    .kitchen { height: calc(100vh - 100px); height: calc(100dvh - 100px); min-height: 400px; display: flex; flex-direction: column; gap: .75rem; }
    .k-header { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; padding: .6rem 1rem; background: #212529; color: #fff; border-radius: .5rem; }
    .k-header h1 { font-size: 1.8rem; margin: 0; font-weight: 700; }
    .k-counts { display: flex; gap: .5rem; flex-wrap: wrap; flex: 1; }
    .k-count { font-size: 1.1rem; padding: .25rem .7rem; border-radius: 2rem; background: rgba(255,255,255,.12); white-space: nowrap; }
    .k-count b { font-size: 1.4rem; margin-left: .3rem; }
    .k-clock { font-size: 2rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .k-conn { font-size: 1rem; display: flex; align-items: center; gap: .4rem; }
    .k-dot { width: .9rem; height: .9rem; border-radius: 50%; background: #6c757d; display: inline-block; }
    .k-dot.connected { background: #198754; }
    .k-dot.reconnecting { background: #ffc107; }
    .k-dot.disconnected { background: #dc3545; }
    .k-board { flex: 1; min-height: 0; display: flex; gap: .75rem; }
    .k-col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; background: #f1f3f5; border-radius: .5rem; border-top: .5rem solid var(--col-color); }
    .k-col.k-ready { flex: .6 1 0; --col-color: #198754; }
    .k-col.k-new { --col-color: #0d6efd; }
    .k-col.k-progress { --col-color: #fd7e14; }
    .k-col.collapsed { flex: 0 0 4.5rem; }
    .k-col.collapsed .k-body { display: none; }
    .k-col.collapsed .k-col-title { writing-mode: vertical-rl; margin: .5rem auto; }
    .k-col-head { display: flex; align-items: center; justify-content: space-between; padding: .5rem .75rem; }
    .k-col-title { font-size: 1.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; }
    .k-col.collapsed .k-col-head { flex-direction: column; }
    .k-body { flex: 1; min-height: 0; overflow-y: auto; padding: 0 .6rem .6rem; display: flex; flex-direction: column; gap: .6rem; }
    .k-empty { text-align: center; color: #868e96; padding: 2rem 0; font-size: 1.2rem; }
    .k-card { background: #fff; border-radius: .5rem; border: 2px solid #dee2e6; padding: .75rem 1rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
    .k-card.warn { background: #fff3cd; border-color: #ffc107; }
    .k-card.danger { background: #f8d7da; border-color: #dc3545; }
    .k-card.flash { animation: k-flash 1s ease-in-out 4; }
    @@keyframes k-flash { 0%,100% { box-shadow: 0 0 0 0 rgba(13,110,253,0); } 50% { box-shadow: 0 0 0 8px rgba(13,110,253,.55); transform: scale(1.015); } }
    .k-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; }
    .k-table { font-size: 2rem; font-weight: 800; line-height: 1.1; }
    .k-meta { color: #6c757d; font-size: 1.05rem; }
    .k-elapsed { font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .k-lines { list-style: none; margin: .5rem 0; padding: 0; font-size: 1.4rem; }
    .k-lines li { padding: .15rem 0; border-top: 1px solid rgba(0,0,0,.08); }
    .k-lines li:first-child { border-top: 0; }
    .k-qty { font-weight: 800; }
    .k-line-note { font-style: italic; font-size: 1.1rem; color: #495057; }
    .k-note { background: #ffe066; border-left: .4rem solid #f08c00; padding: .4rem .6rem; font-weight: 600; font-size: 1.2rem; border-radius: .25rem; margin-bottom: .5rem; }
    .k-actions { display: flex; gap: .5rem; }
    .k-actions .btn-main { flex: 1; font-size: 1.5rem; font-weight: 700; padding: .6rem; }
    .k-actions .btn-cancel { font-size: 1.3rem; padding: .6rem .9rem; }
    @@media (max-width: 767.98px) {
        .kitchen { height: auto; }
        .k-board { flex-direction: column; }
        .k-col, .k-col.k-ready, .k-col.collapsed { flex: none; }
        .k-body { overflow: visible; max-height: none; }
        .k-col.collapsed .k-col-title { writing-mode: horizontal-tb; margin: 0; }
        .k-col.collapsed .k-col-head { flex-direction: row; }
        .k-lines { font-size: 1.25rem; }
    }
</style>
}

<div class="kitchen">
    <div class="k-header">
        <h1>Orders tonight</h1>
        <div class="k-counts">
            <span class="k-count">New<b id="cnt-New">0</b></span>
            <span class="k-count">In progress<b id="cnt-InProgress">0</b></span>
            <span class="k-count">Ready<b id="cnt-Ready">0</b></span>
            <span class="k-count">Served<b id="cnt-Served">0</b></span>
        </div>
        <div class="k-clock" id="k-clock">--:--</div>
        <div class="k-conn"><span class="k-dot" id="k-dot"></span><span id="k-conn-text">Connecting</span></div>
        <button type="button" class="btn btn-outline-light" id="k-sound" aria-pressed="false">Sound: off</button>
    </div>

    <div class="k-board">
        <section class="k-col k-new" id="col-New">
            <div class="k-col-head"><span class="k-col-title">New</span><span class="badge bg-primary fs-5" id="badge-New">0</span></div>
            <div class="k-body" id="body-New"></div>
        </section>
        <section class="k-col k-progress" id="col-InProgress">
            <div class="k-col-head"><span class="k-col-title">In progress</span><span class="badge bg-warning text-dark fs-5" id="badge-InProgress">0</span></div>
            <div class="k-body" id="body-InProgress"></div>
        </section>
        <section class="k-col k-ready" id="col-Ready">
            <div class="k-col-head">
                <span class="k-col-title">Ready</span>
                <span class="d-flex align-items-center gap-2">
                    <span class="badge bg-success fs-5" id="badge-Ready">0</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="k-collapse" title="Collapse or expand">&#8596;</button>
                </span>
            </div>
            <div class="k-body" id="body-Ready"></div>
        </section>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="k-toasts" style="z-index:2000"></div>

@section Scripts {
    <script src="~/js/kitchen.js" asp-append-version="true"></script>
}
